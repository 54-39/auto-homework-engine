{
  "manifest_version": 3,
  "name": "作业助手",
  "version": "0.2.0",
  "description": "自动完成网页作业：提取题目 → AI 答题 → 自动填写。支持豆包网页桥接（免费）/ OpenAI 兼容 API。",
  "permissions": ["storage", "tabs", "scripting", "notifications"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.doubao.com/*"],
      "js": [
        "content/homework/adapters/chaoxing.js",
        "content/homework/extractor.js",
        "content/homework/filler.js",
        "content/homework/panel.js",
        "content/homework/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.doubao.com/*"],
      "js": ["content/doubao/doubao-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
