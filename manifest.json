{
  "manifest_version": 3,
  "name": "作业助手",
  "version": "0.6.11",
  "description": "网页作业 AI 辅助：提取题目、生成答案并自动填写；支持多家 API、豆包网页桥接与安全更新。",
  "permissions": ["storage", "tabs", "scripting", "notifications", "nativeMessaging"],
  "optional_permissions": ["downloads"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.doubao.com/*"],
      "js": [
        "content/homework/adapters/chaoxing.js",
        "content/homework/dropdown.js",
        "content/homework/extractor.js",
        "content/homework/filler.js",
        "content/homework/panel.js",
        "content/homework/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.doubao.com/*"],
      "js": ["content/doubao/doubao-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
