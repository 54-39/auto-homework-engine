{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.9.38",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "notifications",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.doubao.com/*",
    "https://api.deepseek.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://api.z.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*"
      ],
      "js": [
        "content/homework/adapters/chaoxing.js",
        "content/homework/dropdown.js",
        "content/homework/diagnostics.js",
        "content/homework/extractor.js",
        "content/homework/font-decoder.js",
        "content/homework/ai-extractor.js",
        "content/homework/filler.js",
        "content/course/watch.js",
        "content/course/survey.js",
        "content/course/bbs.js",
        "content/homework/panel.js",
        "content/homework/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.doubao.com/*"
      ],
      "js": [
        "content/doubao/doubao-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
