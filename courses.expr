(() => {
  const links = [...document.querySelectorAll('a[href]')]
    .map((a) => ({ t: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 22), h: a.href }))
    .filter((x) => /courseId=/i.test(x.h));
  const seen = new Set();
  const out = [];
  for (const x of links) {
    const cid = (x.h.match(/courseId=(\d+)/) || [])[1];
    if (!cid || seen.has(cid) || x.t.length < 2) continue;
    seen.add(cid);
    out.push(x.t + ' => ' + cid);
  }
  return out.slice(0, 15).join(' ;; ') || ('课程链接0条, 页面: ' + document.body.textContent.replace(/\s+/g, ' ').slice(0, 120));
})()
